# Copy to .env.local for local dev; set the same vars in Vercel project settings.

# The job views query Supabase from the browser, so these two are the PUBLIC
# anon values (safe to ship to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# /api/flag27 posts to Discord from the server.
DISCORD_FLAG27_WEBHOOK_URL=

# Mailer, server-side only. Same Supabase project as above -- used for auth
# session handling and for the mailer_* tables (RLS disabled, every query
# filters user_id).
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-anon-key>

# AES-256-GCM key for the stored Gmail app passwords. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing or losing this makes every stored account unreadable until re-entered.
ENCRYPTION_KEY=

# Gmail accounts are NOT configured here -- each user adds their own in the
# app, stored encrypted per user in mailer_accounts.

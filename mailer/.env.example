# Shared with the scraper and the outreach app. SUPABASE_KEY is the anon key;
# it is used both for data access (RLS disabled, server-only) and for Supabase
# Auth session handling.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=

# AES-256-GCM key for Gmail app passwords at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing or losing this makes every stored account unreadable until re-entered.
ENCRYPTION_KEY=

# Gmail accounts are NOT configured here any more -- each user adds their own
# in the app, and they are stored encrypted per user in mailer_accounts.

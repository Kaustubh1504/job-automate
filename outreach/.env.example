# Copy to .env and fill in. Never commit real values.
# Tip: the repo root .env already has all of the Supabase + Gmail values.

# Existing Supabase project. SUPABASE_KEY (anon) works because RLS is disabled;
# SUPABASE_SERVICE_ROLE_KEY is used instead if set.
SUPABASE_URL=
SUPABASE_KEY=

# LLM steps run via `claude -p` (headless Claude Code) — no API key needed,
# it uses your existing Claude Code auth. Override the binary path if needed:
# CLAUDE_BIN=/usr/local/bin/claude

# Gmail app password, same mechanism as mailer/gmail.py:
# create at https://myaccount.google.com/apppasswords (requires 2FA)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Shared secret the Raspberry Pi cron sends as a Bearer token (used from step 7)
CRON_SECRET=

# Signature identity for drafts + reply detection
USER_NAME=
USER_EMAIL=
